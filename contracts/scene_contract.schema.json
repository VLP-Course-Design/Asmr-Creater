            "type": "object",
            "description": "可选单目相对深度提示;字段完整时才可出现,低质量结果应整体省略。",
            "required": [
              "type",
              "value",
              "class",
              "uncertainty",
              "region_spread",
              "source",
              "normalization",
              "sample_region"
