{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asmr-creater/contracts/scene_contract.schema.json",
  "title": "ASMR Creater 视觉记录契约 v2.3",
  "description": "视觉层单张图片结构化记录的正式 JSON Schema 定义。v2.3 已获团队正式批准，替代原冻结 v1.0 Scene Contract，作为视觉层与音频层的主接口。字段语义详见 docs/playback/ 与 contracts/playback_proposal/ 下的词表和示范记录。",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "image",
    "global_vibe",
    "trigger_anchors"
  ],
  "additionalProperties": false,
  "$comment": "以下业务规则超出 JSON Schema draft-07 的表达能力,必须在应用代码中另行校验(参见 src/audio/playback_converter.py 的 validate_record()/validate_bbox()):1) bbox_norm 需满足 x_min<x_max 且 y_min<y_max;2) global_vibe.secondary_scene_types 的元素不得与 scene_type 相同;3) global_vibe.scene_group 必须是 scene_type 在 scene_type_vocabulary.json 中实际所属的组;4) id 建议全数据集内唯一(单条记录级 schema 无法校验跨记录约束)。",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.3",
      "description": "单条视觉记录所遵循的数据结构版本,当前固定为 2.3。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "图片记录的稳定标识,建议整个数据集内唯一;不得使用易变化的绝对路径作为 ID。"
    },
    "image": {
      "type": "object",
      "required": [
        "path",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\.\\.)(?![A-Za-z]:)(?!/)[^\\\\]+$",
          "description": "数据集根目录相对路径,统一使用正斜杠 /;禁止绝对路径、盘符和 .. 路径穿越。"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "修正 EXIF 方向后图片的像素宽度,须从实际解码结果读取。"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "修正 EXIF 方向后图片的像素高度,须从实际解码结果读取。"
        }
      }
    },
    "global_vibe": {
      "type": "object",
      "required": [
        "scene_type",
        "secondary_scene_types",
        "scene_group",
        "mood",
        "warmth",
        "time_of_day",
        "brightness"
      ],
