            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "relative_monocular"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "0 表示相对靠近相机,1 表示相对远离相机;只在同一图片内部有效。"
              },
              "class": {
                "type": "string",
                "enum": [
                  "near",
                  "mid",
                  "far",
                  "unknown"
                ]
              },
              "uncertainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "0 最可靠,1 最不可靠;建议 >0.8 时省略整个 depth_hint。"
              },
              "region_spread": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "采样区域内部深度分布的离散程度,建议为 P90-P10。"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "normalization": {
                "const": "per_image_percentile_p02_p98"
              },
              "sample_region": {
                "type": "string",
                "enum": [
                  "instance_mask",
                  "bbox_inner_20_percent"
                ]
              }
            }
          }
        }
      }
