          "bbox_norm": {
            "type": "object",
            "required": [
              "format",
              "x_min",
              "y_min",
              "x_max",
              "y_max"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "const": "xyxy"
              },
              "x_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "x_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "description": "修正 EXIF 后原图上的归一化边界框;须满足 x_min<x_max 且 y_min<y_max(应用层校验)。"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "检测器认为目标存在且类别匹配的置信度;不得直接作为发声概率/音量。"
