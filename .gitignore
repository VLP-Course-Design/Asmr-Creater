# 数据集(体积过大,不纳入版本控制)
img_dataset/
data/
*.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# 模型权重(体积大,不纳入版本控制)
*.pt
*.onnx

# 音频素材本体(体积大,不纳入版本控制);
# sounds/ 的目录结构、trigger_map.json、metadata.csv、README 仍纳入版本控制
sounds/**/*.wav
sounds/**/*.mp3
sounds/**/*.flac
sounds/**/*.ogg
sounds/**/*.aac

# 环境与密钥
.env
*.key

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp

# 输出产物
outputs/
*.log

# 第二人本地交接 / 备忘，不进功能分支
handover_v23/
personal_work_readme.md

AGENTS.md

# Freesound 采集管线(sounds/fs_collect.py)
# 注意:.gitignore 不支持行尾注释,注释必须独占一行,否则会被当成 pattern 的一部分。
# OAuth access_token,绝不入库
sounds/.fs_oauth.json
# 搜索中间产物,可随时重跑再生
sounds/candidates.json
# 下载的素材工作区(wav 本体不入库)
sounds/assets/

# 课程交付文件(docs 下):Word 报告/个人贡献、参考 PDF、报告插图。
# 仓库只跟踪 Markdown 文档;二进制交付物本地保留,不入库。
docs/**/*.docx
docs/**/*.pdf
# Word 打开文档时生成的临时锁文件
~$*.docx
# 报告插图(fig 前缀);项目流程图 docs/MVP版本工作流程.png 仍保留跟踪
docs/fig*.png
