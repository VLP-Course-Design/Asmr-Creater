{
  "version": "1.0",
  "field": "global_vibe.scene_type",
  "format": "lowercase_snake_case",
  "cardinality": "exactly_one",
  "fallback_for_non_scene": "none",
  "rules": [
    "Choose the dominant physical environment, not the most prominent object.",
    "Use exactly one value; never join values with slash, comma, or plus.",
    "Use none when the image has no coherent physical environment, including memes, stickers, screenshots, documents, slides, code, UI, isolated products, portraits, macro shots, and detail close-ups.",
    "Use other_indoor, other_outdoor, other_natural, or other_transport when a coherent environment exists but no specific controlled value fits.",
    "Do not encode mood, brightness, warmth, weather, or time of day inside scene_type when those attributes have their own fields."
  ],
